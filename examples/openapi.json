{
  "openapi": "3.1.0",
  "info": {
    "title": "Mafer GC-MS screening API",
    "description": "Upload a ZIP containing one complete ChemStation .D/data.ms. Results are screening candidates, not confirmed identities. Times are seconds.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/sample": {
      "get": {
        "summary": "Analyze the optional GCMS_SAMPLE acquisition using the configured library",
        "operationId": "sample_dashboard_v1_sample_get",
        "parameters": [
          {
            "name": "smoothing_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 5,
              "minimum": 0,
              "default": 0.8,
              "title": "Smoothing Seconds"
            }
          },
          {
            "name": "baseline_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 300,
              "minimum": 10,
              "default": 60,
              "title": "Baseline Seconds"
            }
          },
          {
            "name": "min_width_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 10,
              "minimum": 0.1,
              "default": 0.6,
              "title": "Min Width Seconds"
            }
          },
          {
            "name": "max_width_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 120,
              "minimum": 1,
              "default": 30,
              "title": "Max Width Seconds"
            }
          },
          {
            "name": "coapex_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 2,
              "minimum": 0,
              "default": 0.5,
              "title": "Coapex Seconds"
            }
          },
          {
            "name": "noise_multiplier",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 50,
              "minimum": 3,
              "default": 8,
              "title": "Noise Multiplier"
            }
          },
          {
            "name": "min_ions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 2,
              "default": 3,
              "title": "Min Ions"
            }
          },
          {
            "name": "relative_ion_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.2,
              "minimum": 0,
              "default": 0.01,
              "title": "Relative Ion Threshold"
            }
          },
          {
            "name": "min_component_fraction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.1,
              "minimum": 0,
              "default": 0.001,
              "title": "Min Component Fraction"
            }
          },
          {
            "name": "match_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "minimum": 0,
              "default": 0.75,
              "title": "Match Threshold"
            }
          },
          {
            "name": "ambiguity_margin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.2,
              "minimum": 0,
              "default": 0.03,
              "title": "Ambiguity Margin"
            }
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 3,
              "title": "Top K"
            }
          },
          {
            "name": "output",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "json",
                "html"
              ],
              "type": "string",
              "default": "json",
              "title": "Output"
            }
          },
          {
            "name": "engine",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "python",
                "rust"
              ],
              "type": "string",
              "default": "python",
              "title": "Engine"
            }
          },
          {
            "name": "review",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Review"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnalysisReport"
                    },
                    {
                      "$ref": "#/components/schemas/ReviewReport"
                    }
                  ],
                  "title": "Response Sample Dashboard V1 Sample Get"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Another request is active; retry later"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/library": {
      "get": {
        "summary": "Library Info",
        "operationId": "library_info_v1_library_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/analyze": {
      "post": {
        "summary": "Analyze Upload",
        "operationId": "analyze_upload_v1_analyze_post",
        "parameters": [
          {
            "name": "smoothing_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 5,
              "minimum": 0,
              "default": 0.8,
              "title": "Smoothing Seconds"
            }
          },
          {
            "name": "baseline_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 300,
              "minimum": 10,
              "default": 60,
              "title": "Baseline Seconds"
            }
          },
          {
            "name": "min_width_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 10,
              "minimum": 0.1,
              "default": 0.6,
              "title": "Min Width Seconds"
            }
          },
          {
            "name": "max_width_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 120,
              "minimum": 1,
              "default": 30,
              "title": "Max Width Seconds"
            }
          },
          {
            "name": "coapex_seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 2,
              "minimum": 0,
              "default": 0.5,
              "title": "Coapex Seconds"
            }
          },
          {
            "name": "noise_multiplier",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 50,
              "minimum": 3,
              "default": 8,
              "title": "Noise Multiplier"
            }
          },
          {
            "name": "min_ions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 2,
              "default": 3,
              "title": "Min Ions"
            }
          },
          {
            "name": "relative_ion_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.2,
              "minimum": 0,
              "default": 0.01,
              "title": "Relative Ion Threshold"
            }
          },
          {
            "name": "min_component_fraction",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.1,
              "minimum": 0,
              "default": 0.001,
              "title": "Min Component Fraction"
            }
          },
          {
            "name": "match_threshold",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "minimum": 0,
              "default": 0.75,
              "title": "Match Threshold"
            }
          },
          {
            "name": "ambiguity_margin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.2,
              "minimum": 0,
              "default": 0.03,
              "title": "Ambiguity Margin"
            }
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10,
              "minimum": 1,
              "default": 3,
              "title": "Top K"
            }
          },
          {
            "name": "output",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "json",
                "html"
              ],
              "type": "string",
              "default": "json",
              "title": "Output"
            }
          },
          {
            "name": "engine",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "python",
                "rust"
              ],
              "type": "string",
              "default": "python",
              "title": "Engine"
            }
          },
          {
            "name": "review",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Review"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnalysisReport"
                    },
                    {
                      "$ref": "#/components/schemas/ReviewReport"
                    }
                  ],
                  "title": "Response Analyze Upload V1 Analyze Post"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "408": {
            "description": "Upload did not complete within 60 seconds"
          },
          "413": {
            "description": "Upload or expanded data exceeds documented limits"
          },
          "415": {
            "description": "Use Content-Type: application/zip"
          },
          "422": {
            "description": "Invalid ZIP, acquisition format or processing parameters"
          },
          "503": {
            "description": "Another request is active; retry later"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/zip": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisReport": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "algorithm_version": {
            "type": "string",
            "title": "Algorithm Version",
            "default": "coapex-1"
          },
          "sample_name": {
            "type": "string",
            "title": "Sample Name"
          },
          "provenance": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provenance"
          },
          "acquisition": {
            "additionalProperties": true,
            "type": "object",
            "title": "Acquisition"
          },
          "parameters": {
            "$ref": "#/components/schemas/Parameters"
          },
          "library": {
            "additionalProperties": true,
            "type": "object",
            "title": "Library"
          },
          "summary": {
            "additionalProperties": true,
            "type": "object",
            "title": "Summary"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "chromatogram": {
            "additionalProperties": true,
            "type": "object",
            "title": "Chromatogram"
          },
          "components": {
            "items": {
              "$ref": "#/components/schemas/Component"
            },
            "type": "array",
            "title": "Components"
          }
        },
        "type": "object",
        "required": [
          "sample_name",
          "provenance",
          "acquisition",
          "parameters",
          "library",
          "summary",
          "warnings",
          "chromatogram",
          "components"
        ],
        "title": "AnalysisReport"
      },
      "Candidate": {
        "properties": {
          "group_id": {
            "type": "string",
            "title": "Group Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "identities": {
            "items": {
              "$ref": "#/components/schemas/Identity"
            },
            "type": "array",
            "title": "Identities"
          },
          "library_intensity_fraction_in_mass_range": {
            "type": "number",
            "title": "Library Intensity Fraction In Mass Range"
          },
          "reference_spectrum": {
            "$ref": "#/components/schemas/Spectrum"
          }
        },
        "type": "object",
        "required": [
          "group_id",
          "score",
          "identities",
          "library_intensity_fraction_in_mass_range",
          "reference_spectrum"
        ],
        "title": "Candidate"
      },
      "Component": {
        "properties": {
          "component_id": {
            "type": "string",
            "title": "Component Id"
          },
          "apex_scan": {
            "type": "integer",
            "title": "Apex Scan"
          },
          "start_seconds": {
            "type": "number",
            "title": "Start Seconds"
          },
          "apex_seconds": {
            "type": "number",
            "title": "Apex Seconds"
          },
          "end_seconds": {
            "type": "number",
            "title": "End Seconds"
          },
          "area": {
            "type": "number",
            "title": "Area"
          },
          "area_percent": {
            "type": "number",
            "title": "Area Percent"
          },
          "apexing_ion_count": {
            "type": "integer",
            "title": "Apexing Ion Count"
          },
          "spectrum": {
            "$ref": "#/components/schemas/Spectrum"
          },
          "status": {
            "type": "string",
            "enum": [
              "tentative",
              "ambiguous",
              "unassigned"
            ],
            "title": "Status"
          },
          "score_margin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score Margin"
          },
          "close_candidate_groups": {
            "type": "integer",
            "title": "Close Candidate Groups"
          },
          "spectral_change": {
            "type": "number",
            "title": "Spectral Change"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          }
        },
