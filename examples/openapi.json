      },
      "IonTrace": {
        "properties": {
          "mz": {
            "type": "number",
            "title": "Mz"
          },
          "intensity": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Intensity"
          }
        },
        "type": "object",
        "required": [
          "mz",
          "intensity"
        ],
        "title": "IonTrace"
      },
      "Parameters": {
        "properties": {
          "smoothing_seconds": {
            "type": "number",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Smoothing Seconds",
            "default": 0.8
          },
          "baseline_seconds": {
            "type": "number",
            "maximum": 300.0,
            "minimum": 10.0,
            "title": "Baseline Seconds",
            "default": 60
          },
          "min_width_seconds": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.1,
            "title": "Min Width Seconds",
            "default": 0.6
          },
          "max_width_seconds": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Max Width Seconds",
            "default": 30
          },
          "coapex_seconds": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Coapex Seconds",
            "default": 0.5
          },
          "noise_multiplier": {
            "type": "number",
            "maximum": 50.0,
            "minimum": 3.0,
            "title": "Noise Multiplier",
            "default": 8
          },
          "min_ions": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 2.0,
            "title": "Min Ions",
            "default": 3
          },
          "relative_ion_threshold": {
            "type": "number",
            "maximum": 0.2,
            "minimum": 0.0,
            "title": "Relative Ion Threshold",
            "default": 0.01
          },
          "min_component_fraction": {
            "type": "number",
            "maximum": 0.1,
            "minimum": 0.0,
            "title": "Min Component Fraction",
            "default": 0.001
          },
          "match_threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Match Threshold",
            "default": 0.75
          },
          "ambiguity_margin": {
            "type": "number",
            "maximum": 0.2,
            "minimum": 0.0,
            "title": "Ambiguity Margin",
            "default": 0.03
          },
          "top_k": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 3
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Parameters"
      },
      "PeakTrace": {
        "properties": {
          "time_seconds": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Time Seconds"
          },
          "raw_tic": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Raw Tic"
          },
          "corrected_tic": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Corrected Tic"
          },
          "component_ion_sum": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Component Ion Sum"
          },
