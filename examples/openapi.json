          "apex_scan",
          "start_seconds",
          "apex_seconds",
          "end_seconds",
          "area",
          "area_percent",
          "apexing_ion_count",
          "spectrum",
          "status",
          "score_margin",
          "close_candidate_groups",
          "spectral_change",
          "warnings",
          "candidates"
